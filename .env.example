# Auto-Return Configuration
# IMPORTANT: Auto-return settings are controlled ONLY via .env file
# Server will sync these settings to database automatically on startup
#
# AUTO_RETURN_RFID_IDS: List of RFID IDs that should use auto-return mode
# Separate multiple IDs with commas (no spaces)
# Example: AUTO_RETURN_RFID_IDS=A1B2C3D4,E5F6G7H8,I9J0K1L2
# Leave empty to disable auto-return for all teachers
AUTO_RETURN_RFID_IDS=A1B2C3D4,E5F6G7H8,I9J0K1L2

# AUTO_RETURN_MIN_MINUTES: Minimum duration before auto-return (in minutes)
# Teachers will not auto-return before this duration
# Example: 20 = minimum 20 minutes before auto-return
AUTO_RETURN_MIN_MINUTES=20

# AUTO_RETURN_MAX_MINUTES: Maximum duration for auto-return (in minutes)
# Teachers will auto-return automatically if duration is between MIN and MAX
# Example: 30 = auto-return if between 20-30 minutes
# Set to 0 or leave empty for no maximum (only minimum check)
AUTO_RETURN_MAX_MINUTES=30

# AUTO_RETURN_CHECK_INTERVAL: How often to check for auto-return (in seconds)
# Default: 30 seconds
# Lower value = more frequent checks but higher CPU usage
AUTO_RETURN_CHECK_INTERVAL=30
